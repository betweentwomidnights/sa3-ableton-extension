# Server
PORT=8006

# Hugging Face token with accepted access for:
# - stabilityai/stable-audio-3-medium
# - google/t5gemma-b-b-ul2
HF_TOKEN=

# Stable Audio 3 model name. `medium` needs CUDA + Flash Attention.
SA3_MODEL=medium
SA3_MODEL_HALF=1

# Defaults used when a request omits fields.
SA3_DEFAULT_STEPS=8
SA3_DEFAULT_CFG=1.0
SA3_DEFAULT_NEGATIVE=low quality
SA3_DEFAULT_DURATION=30
SA3_MAX_DURATION=300
SA3_DEFAULT_SAMPLER=pingpong
SA3_SAMPLE_RATE=44100

# Local folders. Relative defaults live under this backend directory.
# SA3_PROMPTS_DIR=./prompts
# SA3_LORA_DIR=./loras
# SA3_LORA_REGISTRY=./lora_registry.json
# SA3_DEFAULT_LORA=
# OUTPUT_DIR=./outputs

# Optional output shaping. Use `off` or leave empty to disable nullable fields.
SA3_LATENT_RESCALE=1.0
SA3_LATENT_SHIFT=0.0
SA3_LATENT_TARGET_STD=
SA3_LATENT_ADAPT_MIN=0.9
SA3_LATENT_ADAPT_MAX=1.0
SA3_PEAK_NORMALIZE_DB=2.0
SA3_LIMITER_CEILING_DB=-0.3
SA3_LIMITER_KNEE=0.8

# Continue generates slightly past the requested end and trims back to target.
SA3_CONTINUE_TAIL_MODE=regen_past
SA3_CONTINUE_TAIL_PAD=6
