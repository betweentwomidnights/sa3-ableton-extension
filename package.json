{
  "name": "gary-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "npm run build:js && npm run build:native",
    "build:js": "tsc --noEmit && tsx build.ts",
    "build:native": "node scripts/build-native.cjs",
    "package:ablx": "npm run build && extensions-cli package -o dist/gary-extension.ablx -i dist/native && node scripts/copy-release.cjs",
    "package:cuda": "node scripts/package.cjs cuda",
    "package:vulkan": "node scripts/package.cjs vulkan",
    "package:cpu": "node scripts/package.cjs cpu",
    "package:metal": "node scripts/package.cjs metal",
    "package:all": "node scripts/package.cjs cuda vulkan cpu",
    "start": "npm run start:cli",
    "start:cli": "npm run build && extensions-cli run",
    "start:debug": "npm run build && extensions-cli run --inspect",
    "start:win": "npm run build && node scripts/run-dev-host.cjs"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^25.0.10",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
